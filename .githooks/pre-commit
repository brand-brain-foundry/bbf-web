#!/bin/bash
# pre-commit: gitleaks staged — bbf-web
# gitleaks 8.30.x: --exit-code 2 = leaks; exit 0 = limpio; exit !=2 = error del tool
# F-07: no usar -q (bug gitleaks); exit-code 2 semántico

set -uo pipefail

if ! command -v gitleaks &>/dev/null; then
  echo "[pre-commit] gitleaks no encontrado — skip (instalar: brew install gitleaks)" >&2
  exit 0
fi

gitleaks protect --staged --no-banner --exit-code 2 --redact --verbose
GL_STATUS=$?

if [ "$GL_STATUS" -eq 2 ]; then
  echo "" >&2
  echo "[pre-commit] S-4: gitleaks detectó secreto en staged files — commit cancelado" >&2
  echo "  Eliminar el secreto, luego: git add <archivo> && git commit" >&2
  exit 1
elif [ "$GL_STATUS" -ne 0 ]; then
  echo "" >&2
  echo "[pre-commit] S-4 FAIL-CLOSED: error del tool gitleaks (exit $GL_STATUS) — commit cancelado" >&2
  exit 1
fi

# ─── GUARDIA DE COLOR (D-COLOR-SPACE forma B) ────────────────────────────────
# Mismo molde fail-closed que gitleaks: escanea staged en scope y rompe el
# commit si aparece un HEX crudo NUEVO fuera de primitives/colors*.css (no en
# .colorbaseline). Escape hatch por línea: // COLOR-ALLOW: <razón> (TS/TSX) o
# /* COLOR-ALLOW: <razón> */ (CSS). Silent-pass si pnpm/tsx no está (problema
# de entorno dev, no de la guardia).
if ! command -v pnpm &>/dev/null; then
  echo "[pre-commit] pnpm no encontrado — skip guardia de color" >&2
  exit 0
fi

pnpm exec tsx scripts/lint/check-color-tokens.ts --staged
COLOR_STATUS=$?

if [ "$COLOR_STATUS" -eq 1 ]; then
  echo "" >&2
  echo "[pre-commit] S-4: guardia de color detectó HEX nuevo en staged files — commit cancelado" >&2
  echo "  Usar un token existente, o // COLOR-ALLOW: <razón> si es legítimo." >&2
  exit 1
elif [ "$COLOR_STATUS" -ne 0 ]; then
  echo "" >&2
  echo "[pre-commit] S-4 FAIL-CLOSED: error de la guardia de color (exit $COLOR_STATUS) — commit cancelado" >&2
  echo "  Verificar: pnpm exec tsx scripts/lint/check-color-tokens.ts" >&2
  exit 1
fi

# ─── GUARDIA DE TIPOGRAFÍA (D-TYPO-RATIO-FIX) ────────────────────────────────
# Mismo molde fail-closed, corre DESPUÉS de la guardia de color. Rompe el
# commit si aparece un font-size/font-weight crudo NUEVO fuera de
# primitives/typography.css (no en .typographybaseline). Escape hatch por
# línea: // TYPO-ALLOW: <razón> (TS/TSX) o /* TYPO-ALLOW: <razón> */ (CSS).
pnpm exec tsx scripts/lint/check-typography-tokens.ts --staged
TYPO_STATUS=$?

if [ "$TYPO_STATUS" -eq 0 ]; then
  exit 0
elif [ "$TYPO_STATUS" -eq 1 ]; then
  echo "" >&2
  echo "[pre-commit] S-4: guardia de tipografía detectó font-size/font-weight nuevo en staged files — commit cancelado" >&2
  echo "  Usar un token existente, o // TYPO-ALLOW: <razón> si es legítimo." >&2
  exit 1
else
  echo "" >&2
  echo "[pre-commit] S-4 FAIL-CLOSED: error de la guardia de tipografía (exit $TYPO_STATUS) — commit cancelado" >&2
  echo "  Verificar: pnpm exec tsx scripts/lint/check-typography-tokens.ts" >&2
  exit 1
fi
